      "tool": {
        "driver": {
          "name": "OmniGuard",
          "rules": [
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "tx.origin participates in a condition that can gate execution."
              },
              "help": {
                "text": "Use msg.sender with an explicit role or ownership check, then add an access-control test. Limitations: Recognizes require/assert conditions and if conditions; does not prove the surrounding policy."
              },
              "helpUri": "https://docs.soliditylang.org/en/latest/security-considerations.html#tx-origin",
              "id": "OG-SOL-001",
              "properties": {
                "category": "authorization",
                "confidence": "high"
              },
              "shortDescription": {
                "text": "Authorization uses tx.origin"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "An address low-level call precedes a write to this contract's storage in the same function."
              },
              "help": {
                "text": "Apply checks-effects-interactions and verify a reentrancy guard with a local regression test. Limitations: Statement-order indicator; no interprocedural control-flow or inherited guard proof."
              },
              "helpUri": "https://docs.soliditylang.org/en/latest/security-considerations.html#reentrancy",
              "id": "OG-SOL-002",
              "properties": {
                "category": "reentrancy",
                "confidence": "medium"
              },
              "shortDescription": {
                "text": "State write follows an external call"
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "An address call/delegatecall/staticcall result is discarded, or its captured success flag is unused."
              },
              "help": {
                "text": "Capture and enforce the success flag, or explicitly return it to a caller that handles failure. Limitations: An observed use is not proof of correct failure handling; complex data-flow is not resolved."
              },
              "helpUri": "https://docs.soliditylang.org/en/latest/units-and-global-variables.html#members-of-address-types",
              "id": "OG-SOL-003",
              "properties": {
                "category": "external-calls",
                "confidence": "high"
              },
              "shortDescription": {
                "text": "Low-level call result is not checked"
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "The boolean from an address send operation is discarded."
              },
              "help": {
                "text": "Handle failed delivery explicitly; prefer a pull-payment design when recipients can reject Ether. Limitations: Requires a locally resolved address receiver; imported or aliased types may remain unknown."
              },
              "helpUri": "https://docs.soliditylang.org/en/latest/security-considerations.html#sending-and-receiving-ether",
              "id": "OG-SOL-004",
              "properties": {
                "category": "external-calls",
                "confidence": "high"
              },
              "shortDescription": {
                "text": "Ether send result is discarded"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "An externally callable function contains delegation to a caller-derived target without a recognized local caller restriction."
              },
              "help": {
                "text": "Use a trusted implementation target and enforce the intended caller/upgrade policy before delegation. Limitations: Tracks direct parameters and local aliases; a direct earlier write invalidates the compared local authority anchor. Helper writes, unresolved modifiers and interprocedural flows remain excluded."
              },
              "helpUri": "https://docs.soliditylang.org/en/latest/security-considerations.html#authorized-proxies",
              "id": "OG-SOL-005",
              "properties": {
                "category": "code-execution",
                "confidence": "high"
              },
              "shortDescription": {
                "text": "Caller controls a delegatecall target"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "An externally callable function contains selfdestruct without a recognized local caller restriction."
              },
              "help": {
                "text": "Remove the operation or enforce the intended caller policy and test unauthorized calls locally. Limitations: Modern EVMs generally transfer the balance without deleting existing code; fork and creation-time semantics vary."
              },
              "helpUri": "https://docs.soliditylang.org/en/latest/units-and-global-variables.html#contract-related",
              "id": "OG-SOL-006",
              "properties": {
                "category": "authorization",
                "confidence": "medium"
              },
              "shortDescription": {
                "text": "Selfdestruct lacks a local caller restriction"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "A loop writes the whole msg.value into storage on each iteration."
              },
              "help": {
                "text": "Compute and validate a per-item allocation before the loop, or require a single recipient per payment. Limitations: Tracks direct writes and unmodified local aliases; does not infer protocol accounting invariants."
              },
              "helpUri": "https://github.com/crytic/slither/wiki/Detector-Documentation#msgvalue-inside-a-loop",
              "id": "OG-SOL-007",
              "properties": {
                "category": "accounting",
                "confidence": "medium"
              },
              "shortDescription": {
                "text": "Loop repeatedly credits the full msg.value"
              }
            },
