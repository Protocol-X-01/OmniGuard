          "name": "OmniGuard",
          "rules": [
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "tx.origin participates in a condition that can gate execution."
              },
              "help": {
                "text": "Use msg.sender with an explicit role or ownership check, then add an access-control test. Limitations: Recognizes require/assert conditions and if conditions; does not prove the surrounding policy."
              },
              "helpUri": "https://docs.soliditylang.org/en/latest/security-considerations.html#tx-origin",
              "id": "OG-SOL-001",
              "properties": {
                "category": "authorization",
                "confidence": "high"
              },
              "shortDescription": {
                "text": "Authorization uses tx.origin"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "An external interaction precedes a write to this contract's storage on a modeled execution path."
              },
              "help": {
                "text": "Apply checks-effects-interactions and verify a reentrancy guard with a local regression test. Limitations: Ordering indicator, not exploit proof. Source mode is local; solc mode follows bounded direct helpers, storage aliases and modifiers. Dynamic dispatch, unresolved effects and exhausted bounds are incomplete; reentrancy-lock safety is not proven."
              },
              "helpUri": "https://docs.soliditylang.org/en/latest/security-considerations.html#reentrancy",
              "id": "OG-SOL-002",
              "properties": {
                "category": "reentrancy",
                "confidence": "medium"
              },
              "shortDescription": {
                "text": "State write follows an external call"
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "An address call/delegatecall/staticcall result is discarded, or its captured success flag is unused."
              },
              "help": {
                "text": "Capture and enforce the success flag, or explicitly return it to a caller that handles failure. Limitations: An observed use is not proof of correct failure handling; complex data-flow is not resolved."
              },
              "helpUri": "https://docs.soliditylang.org/en/latest/units-and-global-variables.html#members-of-address-types",
              "id": "OG-SOL-003",
              "properties": {
                "category": "external-calls",
                "confidence": "high"
              },
              "shortDescription": {
                "text": "Low-level call result is not checked"
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "The boolean from an address send operation is discarded."
              },
              "help": {
                "text": "Handle failed delivery explicitly; prefer a pull-payment design when recipients can reject Ether. Limitations: Requires a locally resolved address receiver; imported or aliased types may remain unknown."
              },
              "helpUri": "https://docs.soliditylang.org/en/latest/security-considerations.html#sending-and-receiving-ether",
              "id": "OG-SOL-004",
              "properties": {
                "category": "external-calls",
                "confidence": "high"
              },
              "shortDescription": {
                "text": "Ether send result is discarded"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "An externally callable path delegates to a caller-derived target without a recognized preceding caller restriction."
              },
              "help": {
                "text": "Use a trusted implementation target and enforce the intended caller/upgrade policy before delegation. Limitations: Source mode tracks local parameters and aliases. Solc mode additionally binds direct helper arguments, storage roots and imported modifiers with bounded ordered effects. No global role-integrity proof; unresolved dispatch or effect limits are incomplete."
              },
              "helpUri": "https://docs.soliditylang.org/en/latest/security-considerations.html#authorized-proxies",
              "id": "OG-SOL-005",
              "properties": {
                "category": "code-execution",
                "confidence": "high"
              },
              "shortDescription": {
                "text": "Caller controls a delegatecall target"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "An externally callable path contains selfdestruct without a recognized preceding caller restriction."
              },
              "help": {
                "text": "Remove the operation or enforce the intended caller policy and test unauthorized calls locally. Limitations: Modern EVMs generally transfer the balance without deleting existing code; fork and creation-time semantics vary."
              },
              "helpUri": "https://docs.soliditylang.org/en/latest/units-and-global-variables.html#contract-related",
              "id": "OG-SOL-006",
              "properties": {
                "category": "authorization",
                "confidence": "medium"
              },
              "shortDescription": {
                "text": "Selfdestruct lacks a local caller restriction"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "A loop writes the whole msg.value into storage on each iteration."
              },
              "help": {
                "text": "Compute and validate a per-item allocation before the loop, or require a single recipient per payment. Limitations: Tracks direct writes and unmodified local aliases; does not infer protocol accounting invariants."
              },
              "helpUri": "https://github.com/crytic/slither/wiki/Detector-Documentation#msgvalue-inside-a-loop",
              "id": "OG-SOL-007",
              "properties": {
                "category": "accounting",
                "confidence": "medium"
              },
              "shortDescription": {
                "text": "Loop repeatedly credits the full msg.value"
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "A block-derived value is used in modulo arithmetic to choose an array index."
              },
              "help": {
                "text": "Use an appropriate verifiable randomness or commit/reveal design with an explicit adversary model. Limitations: Direct expressions and unmodified local aliases; no interprocedural or cryptographic proof."
              },
              "helpUri": "https://docs.soliditylang.org/en/latest/units-and-global-variables.html#block-and-transaction-properties",
              "id": "OG-SOL-008",
              "properties": {
                "category": "randomness",
                "confidence": "high"
              },
              "shortDescription": {
                "text": "Block-derived array selection"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "A hash uses packed encoding of two or more locally resolved string/bytes values, leaving input boundaries ambiguous."
              },
              "help": {
                "text": "Use abi.encode with explicit types and domain separation for the intended hash or signature protocol. Limitations: Currently resolves string/bytes declarations in the same source; purpose and downstream authorization are not inferred."
              },
              "helpUri": "https://docs.soliditylang.org/en/latest/abi-spec.html#non-standard-packed-mode",
              "id": "OG-SOL-009",
              "properties": {
                "category": "encoding",
                "confidence": "high"
              },
              "shortDescription": {
                "text": "Packed hash combines dynamic inputs"
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "A transfer/transferFrom/approve operation declared to return bool is used without its result."
              },
              "help": {
                "text": "Use a compatible SafeERC20 wrapper or enforce the token's return value and test failure behavior. Limitations: Source mode requires an unambiguous in-file interface; compiler mode uses the selected declaration across supplied files and overloads. Method names alone do not imply ERC-20 behavior."
              },
              "helpUri": "https://eips.ethereum.org/EIPS/eip-20",
              "id": "OG-SOL-010",
              "properties": {
                "category": "token-handling",
                "confidence": "high"
              },
              "shortDescription": {
                "text": "Token operation boolean is discarded"
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "A condition requires this contract's Ether balance to equal an exact value."
              },
              "help": {
                "text": "Track internal accounting explicitly and avoid relying on an exact external Ether balance. Limitations: Flags a fragile invariant, not a proven denial of service; intended accounting needs manual review."
              },
              "helpUri": "https://docs.soliditylang.org/en/latest/security-considerations.html#sending-and-receiving-ether",
              "id": "OG-SOL-011",
              "properties": {
                "category": "accounting",
                "confidence": "medium"
              },
              "shortDescription": {
                "text": "Strict equality on contract Ether balance"
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "A payable-address transfer in a loop lets a rejecting recipient revert the whole batch."
              },
              "help": {
                "text": "Use independently claimable payments or isolate recipient failures without losing accounting correctness. Limitations: Does not establish loop bounds, recipient trust or protocol-level impact."
              },
              "helpUri": "https://docs.soliditylang.org/en/latest/security-considerations.html#gas-limit-and-loops",
              "id": "OG-SOL-012",
              "properties": {
                "category": "availability",
                "confidence": "medium"
              },
              "shortDescription": {
                "text": "Reverting Ether transfer inside a loop"
              }
            }
