{
  "name": "omniguard-atlassian-forge",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "scripts": {
    "login": "forge login",
    "reports:generate": "node scripts/generate-fixture-reports.mjs",
    "test": "node --test test/*.test.mjs",
    "build": "node scripts/build-frontend.mjs",
    "validate:manifest": "node scripts/validate-manifest.mjs",
    "lint": "forge lint",
    "register": "forge register",
    "deploy": "forge deploy",
    "install-app": "forge install"
  },
  "dependencies": {
    "@forge/api": "8.5.0",
    "@forge/bridge": "7.3.0",
    "@forge/kvs": "2.1.2",
    "@forge/resolver": "2.0.2"
  },
  "devDependencies": {
    "@forge/cli": "15.1.0",
    "@forge/manifest": "13.9.0",
    "esbuild": "0.25.12"
  },
  "overrides": {
    "glob": "14.0.2",
    "minimatch": "11.0.8",
    "prosemirror-view": "1.42.9"
  },
  "allowScripts": {
    "keytar@7.9.0": true
  }
}
