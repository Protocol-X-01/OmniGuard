{
  "openapi": "3.0.3",
  "info": {
    "title": "OmniGuard front-line local preview",
    "version": "0.1.0",
    "description": "Loopback-only fixture transport for the Forge frontline service. No live Jira writes or network scans. All previews use synthetic observations."
  },
