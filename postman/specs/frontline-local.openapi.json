        "operationId": "importFrontline",
        "summary": "importFrontline",
        "description": "Loopback fixture preview. Jira is simulated and data is in memory. Production uses authenticated Forge context.",
        "parameters": [
          {
            "in": "header",
            "name": "X-OmniGuard-Local",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "bundle"
                ],
                "properties": {
                  "bundle": {
                    "type": "object",
                    "description": "Native frontline bundle; see contracts/frontline-bundle-v1.schema.json."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Action completed in the local fixture workflow.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
