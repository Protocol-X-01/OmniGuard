{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OmniGuard isolated scan bundle v1",
  "type": "object",
  "required": [
    "bundle_version",
    "target",
    "revision",
    "rules",
    "report",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "bundle_version": {
      "const": 1
    },
    "target": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "kind": {
          "const": "isolated-fixture"
        }
      }
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "rules": {
      "type": "array",
      "minItems": 3,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "enum": [
          "OG-SOL-001",
          "OG-SOL-002",
          "OG-SOL-003",
          "OG-SOL-004",
          "OG-SOL-005",
          "OG-SOL-006",
          "OG-SOL-007",
          "OG-SOL-008",
          "OG-SOL-009",
          "OG-SOL-010",
          "OG-SOL-011",
          "OG-SOL-012"
        ]
      }
    },
    "report": {
      "oneOf": [
        {
          "$ref": "report-v1.schema.json"
        },
        {
          "$ref": "report-v2.schema.json"
        },
        {
          "$ref": "report-v3.schema.json"
        }
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "content"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 240
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "content": {
            "type": "string"
          }
        }
      }
    }
  }
}
