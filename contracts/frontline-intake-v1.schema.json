{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "isolated_fixture",
    "engagement_id",
    "name",
    "sequence",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "isolated_fixture": {
      "const": true
    },
    "engagement_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,64}$"
    },
    "name": {
      "type": "string",
      "pattern": "^(?=.*[a-zA-Z0-9_.-])[a-zA-Z0-9 _.-]{1,80}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "owner",
          "check_id",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$"
          },
          "name": {
            "type": "string",
            "pattern": "^(?=.*[a-zA-Z0-9_.-])[a-zA-Z0-9 _.-]{1,80}$"
          },
          "owner": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?=.*[a-zA-Z0-9_.-])[a-zA-Z0-9 _.-]{1,80}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "check_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "source",
                  "captured_at",
                  "expires_at",
                  "facts"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{1,64}$"
                  },
                  "source": {
                    "const": "synthetic_fixture"
                  },
                  "captured_at": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4102444800
                  },
                  "expires_at": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4102444800
                  },
                  "facts": {
                    "type": "object",
                    "maxProperties": 12,
                    "propertyNames": {
                      "pattern": "^[a-zA-Z0-9_-]{1,64}$"
                    },
                    "additionalProperties": {
                      "type": "boolean"
                    }
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
